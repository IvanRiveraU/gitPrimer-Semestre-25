<script>
 (function(){
    var data = {
    "@context":"https://schema.org",
  "@type":"FAQPage",
  "mainEntity":[]
}
    for (i = 0; i < document.querySelectorAll('.preguntas-frecuentes h3').length; i++)
{
    if(document.querySelectorAll('.preguntas-frecuentes h3 ~ p')[i]){    
    data.mainEntity.push({
            "@type":"Question",
            "name":document.querySelectorAll('.preguntas-frecuentes h3')[i].innerText,
            "acceptedAnswer": {
                "@type": "Answer",
                "text":document.querySelectorAll('.preguntas-frecuentes h3 ~ p')[i].innerText
            }
        });
       
    }
    };
  var script = document.createElement('script');
  script.type = "application/ld+json";
  script.innerHTML = JSON.stringify(data);
	console.log(script);
  document.getElementsByTagName('head')[0].appendChild(script);
})(document);
